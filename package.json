{
  "name": "uc-drive2",
  "version": "1.2.0",
  "private": true,
  "description": "uc-drive2 单用户桌面网盘（Tauri + Vue3 + Express + gopeed）",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node server/src/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "build:server": "esbuild server/src/index.js --bundle --platform=node --format=cjs --outfile=server-dist/server.js",
    "build:app": "npm run build && npm run build:server",
    "tauri:build": "npm run build:app && tauri build",
    "test": "npm --prefix server test",
    "test:unit": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.1.7",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "geist": "^1.7.2",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.6",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.2",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.0"
  }
}
