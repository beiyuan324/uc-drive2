{
  "name": "folder-drive",
  "version": "2.3.3",
  "private": true,
  "description": "folder-drive 个人文件管理与多网盘下载工具（Tauri + Vue3 + Rust + SQLite + Gopeed）",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "cargo run --manifest-path src-tauri/Cargo.toml --example folder-drive-server",
    "dev:web": "vite",
    "build": "vite build",
    "check": "vue-tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "build:app": "npm run build",
    "tauri:build": "npm run build:app && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.1.7",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vue-tsc": "^3.1.0"
  }
}
