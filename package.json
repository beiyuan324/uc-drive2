{
  "name": "uc-drive2",
  "version": "2.3.1",
  "private": true,
  "description": "uc-drive2 单用户桌面网盘（Tauri + Vue3 + Rust + SQLite + gopeed）",
  "scripts": {
    "dev": "concurrently -k -n backend,web \"npm:dev:backend\" \"npm:dev:web\"",
    "dev:backend": "cargo run --manifest-path src-tauri/Cargo.toml --example ucdrive2-server",
    "dev:web": "vite",
    "build": "vite build",
    "check": "vue-tsc --noEmit",
    "test:cloud": "node scripts/test-cloud.mjs",
    "build:app": "npm run build",
    "tauri:build": "npm run build:app && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.1.7",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "geist": "^1.7.2",
    "naive-ui": "^2.42.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^6.0.3",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.5",
    "vue-tsc": "^3.1.0"
  }
}
