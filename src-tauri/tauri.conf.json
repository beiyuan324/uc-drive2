{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "folder-drive",
  "version": "2.3.3",
  "identifier": "com.folderdrive.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "folder-drive",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "folder-drive",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bin/gopeed/gopeed-web.exe": "gopeed-web.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/beiyuan324/folder-drive/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVDRDJFMEQ1RjBFQjZBNApSV1NrdGc1ZkRTN05CWFp1MFl3UXRPcG9GOEZEVEJQL042cS9WS0lUZEYwanIvM1dyYVBKZlZiZgo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
