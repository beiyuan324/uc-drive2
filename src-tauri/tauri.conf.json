{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uc-drive2",
  "version": "1.2.0",
  "identifier": "com.ucdrive2.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "uc-drive2",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server-dist/server.js": "server.js",
      "../bin/gopeed/gopeed-web.exe": "gopeed-web.exe"
    },
    "externalBin": ["binaries/node"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
